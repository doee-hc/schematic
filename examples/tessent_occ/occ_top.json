{
  "root": "processor_core_rtl2_tessent_occ",
  "modules": {
    "processor_core_rtl2_tessent_occ": {
      "title": "processor_core_rtl2_tessent_occ",
      "shape": "box",
      "swatch": "family:occ",
      "note": "Tessent OCC — fast/slow mux, TCK inject, CGC, IJTAG control",
      "ports": [
        {"name": "fast_clock", "side": "west", "dir": "in", "swatch": "clock:clk", "keep": true},
        {"name": "slow_clock", "side": "west", "dir": "in", "swatch": "clock:clk", "keep": true},
        {"name": "scan_en", "side": "west", "dir": "in", "swatch": "port:scan", "keep": true},
        {"name": "shift_only_mode", "side": "west", "dir": "in", "swatch": "port:scan"},
        {"name": "ijtag_tck", "side": "west", "dir": "in", "swatch": "port:ijtag", "keep": true},
        {"name": "ijtag_reset", "side": "west", "dir": "in", "swatch": "port:ijtag"},
        {"name": "ijtag_sel", "side": "west", "dir": "in", "swatch": "port:ijtag"},
        {"name": "ijtag_ce", "side": "west", "dir": "in", "swatch": "port:ijtag"},
        {"name": "ijtag_se", "side": "west", "dir": "in", "swatch": "port:ijtag"},
        {"name": "ijtag_ue", "side": "west", "dir": "in", "swatch": "port:ijtag"},
        {"name": "ijtag_si", "side": "west", "dir": "in", "swatch": "port:ijtag"},
        {"name": "ijtag_so", "side": "east", "dir": "out", "swatch": "port:ijtag", "keep": true},
        {"name": "clock_out", "side": "east", "dir": "out", "swatch": "clock:clk", "keep": true},
        {"name": "scan_in", "side": "west", "dir": "in", "swatch": "port:scan", "keep": true},
        {"name": "scan_out", "side": "east", "dir": "out", "swatch": "port:scan", "keep": true}
      ],
      "edges": [
        {"from": "fast_clock", "to": "fast_buf.a", "swatch": "clock:clk"},
        {"from": "fast_buf.y", "to": "occ_control.fast_clock", "swatch": "clock:clk"},
        {"from": "fast_buf.y", "to": "cgc_fast.clk", "swatch": "clock:clk"},
        {"from": "slow_clock", "to": "slow_buf.a", "swatch": "clock:clk"},
        {"from": "slow_buf.y", "to": "inject_mux.a0", "swatch": "clock:clk"},
        {"from": "ijtag_tck", "to": "inject_mux.a1", "swatch": "port:ijtag"},
        {"from": "occ_control.inject_tck", "to": "inject_mux.s0", "swatch": "port:ijtag"},
        {"from": "inject_mux.y", "to": "occ_control.slow_clock", "swatch": "clock:clk"},
        {"from": "inject_mux.y", "to": "cgc_slow.clk", "swatch": "clock:clk"},
        {"from": "scan_en", "to": "scan_en_buf.a", "swatch": "port:scan"},
        {"from": "scan_en_buf.y", "to": "occ_control.scan_en", "swatch": "port:scan"},
        {"from": "shift_only_mode", "to": "occ_control.shift_only_mode", "swatch": "port:scan"},
        {"from": "scan_in", "to": "scan_in_buf.a", "swatch": "port:scan"},
        {"from": "scan_in_buf.y", "to": "occ_control.scan_in", "swatch": "port:scan"},
        {"from": "occ_control.scan_out", "to": "scan_out_buf.a", "swatch": "port:scan"},
        {"from": "scan_out_buf.y", "to": "scan_out", "swatch": "port:scan"},
        {"from": "clock_out", "to": "occ_control.bypass_clock", "swatch": "clock:clk"},
        {"from": "ijtag_tck", "to": "occ_control.ijtag_tck", "swatch": "port:ijtag"},
        {"from": "ijtag_reset", "to": "occ_control.ijtag_reset", "swatch": "port:ijtag"},
        {"from": "ijtag_sel", "to": "occ_control.ijtag_sel", "swatch": "port:ijtag"},
        {"from": "ijtag_ce", "to": "occ_control.ijtag_ce", "swatch": "port:ijtag"},
        {"from": "ijtag_se", "to": "occ_control.ijtag_se", "swatch": "port:ijtag"},
        {"from": "ijtag_ue", "to": "occ_control.ijtag_ue", "swatch": "port:ijtag"},
        {"from": "ijtag_si", "to": "occ_control.ijtag_si", "swatch": "port:ijtag"},
        {"from": "occ_control.ijtag_so", "to": "ijtag_so", "swatch": "port:ijtag"},
        {"from": "occ_control.fast_clock_en", "to": "cgc_fast.en", "swatch": "clock:clk"},
        {"from": "occ_control.fast_clock_en", "to": "cgc_fast.te", "swatch": "clock:clk"},
        {"from": "occ_control.slow_clock_en", "to": "cgc_slow.en", "swatch": "clock:clk"},
        {"from": "occ_control.slow_clock_en", "to": "cgc_slow.te", "swatch": "clock:clk"},
        {"from": "cgc_fast.gck", "to": "out_mux.a0", "swatch": "clock:clk"},
        {"from": "cgc_slow.gck", "to": "out_mux.a1", "swatch": "clock:clk"},
        {"from": "occ_control.clock_mux_select", "to": "out_mux.s0"},
        {"from": "out_mux.y", "to": "clock_out", "swatch": "clock:clk"}
      ],
      "children": [
        {"id": "fast_buf", "use_lib": "clk_buf", "title": "fast_clock_buf"},
        {"id": "slow_buf", "use_lib": "clk_buf", "title": "slow_clock_buf"},
        {"id": "scan_en_buf", "use_lib": "scan_buf", "title": "scan_en_buf"},
        {"id": "scan_in_buf", "use_lib": "scan_buf", "title": "scan_in_buf"},
        {"id": "scan_out_buf", "use_lib": "scan_buf", "title": "scan_out_buf"},
        {"id": "inject_mux", "use_lib": "clk_mux2", "title": "inject_tck_mux"},
        {"id": "occ_control", "use": "processor_core_rtl2_tessent_occ_control", "title": "occ_control"},
        {"id": "cgc_fast", "use_lib": "cgand", "title": "cgc_fast_clock"},
        {"id": "cgc_slow", "use_lib": "cgand", "title": "cgc_slow_clock"},
        {"id": "out_mux", "use_lib": "clk_mux2", "title": "clock_out_mux"}
      ]
    }
  }
}
